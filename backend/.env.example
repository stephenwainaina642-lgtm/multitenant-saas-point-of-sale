# Copy to .env (never commit .env). Values below are placeholders.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nexapos
NODE_ENV=production
PORT=5000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"  (min 32 chars in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated browser origins allowed to call the API (required in production)
CORS_ORIGINS=https://app.example.co.ke
# Set to 1 only when behind a reverse proxy/load balancer (so rate limits see real client IPs)
TRUST_PROXY=1
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=10

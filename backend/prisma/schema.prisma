generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id               BigInt   @id @default(autoincrement())
  ownerUserId      BigInt?  @map("owner_user_id")
  name             String   @db.VarChar(255)
  businessType     String   @default("retail") @map("business_type") @db.VarChar(100)
  email            String?  @db.VarChar(255)
  phone            String?  @db.VarChar(50)
  address          String?
  taxPin           String?  @map("tax_pin") @db.VarChar(20)
  vatRegistered    Boolean  @default(false) @map("vat_registered")
  vatRate          Decimal  @default(16.00) @map("vat_rate") @db.Decimal(5, 2)
  pricesIncludeVat Boolean  @default(false) @map("prices_include_vat")
  currency         String   @default("KES") @db.VarChar(10)
  timezone         String   @default("Africa/Nairobi") @db.VarChar(100)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  memberships        BusinessUser[]
  roles              Role[]
  owner              User?               @relation("BusinessOwner", fields: [ownerUserId], references: [id])
  categories         Category[]
  products           Product[]
  inventoryMovements InventoryMovement[]
  customers          Customer[]
  suppliers          Supplier[]
  purchases          Purchase[]
  sales              Sale[]
  payments           Payment[]
  registerShifts     RegisterShift[]
  expenses           Expense[]
  quotations         Quotation[]
  invoices           Invoice[]
  auditLogs          AuditLog[]
  documentSequences  DocumentSequence[]
  refunds            Refund[]
  supplierPayments   SupplierPayment[]

  branches       Branch[]
  branchStock    BranchStock[]
  stockTransfers StockTransfer[]

  @@map("businesses")
}

model User {
  id                 BigInt    @id @default(autoincrement())
  name               String    @db.VarChar(255)
  email              String    @unique @db.VarChar(255)
  phone              String?   @db.VarChar(50)
  passwordHash       String    @map("password_hash")
  isActive           Boolean   @default(true) @map("is_active")
  sessionsValidAfter DateTime? @map("sessions_valid_after") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  memberships             BusinessUser[]
  passwordResetTokens     PasswordResetToken[]
  ownedBusinesses         Business[]           @relation("BusinessOwner")
  auditLogs               AuditLog[]
  sales                   Sale[]               @relation("SaleSalesperson")
  refundsCreated          Refund[]
  supplierPaymentsCreated SupplierPayment[]
  paymentsReceived        Payment[]            @relation("PaymentReceivedBy")
  shiftsOpened            RegisterShift[]      @relation("ShiftOpenedBy")
  shiftsClosed            RegisterShift[]      @relation("ShiftClosedBy")

  transfersCreated StockTransfer[] @relation("TransferCreator")

  @@map("users")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?
  businessId  BigInt?  @map("business_id")
  permissions String[] @default([])

  business    Business?      @relation(fields: [businessId], references: [id])
  memberships BusinessUser[]

  @@unique([businessId, name])
  @@map("roles")
}

model BusinessUser {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt   @map("business_id")
  userId     BigInt   @map("user_id")
  roleId     BigInt   @map("role_id")
  branchId   BigInt?  @map("branch_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  role     Role     @relation(fields: [roleId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([businessId, userId])
  @@map("business_users")
}

model Branch {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt   @map("business_id")
  name       String   @db.VarChar(120)
  address    String?
  phone      String?  @db.VarChar(50)
  isMain     Boolean  @default(false) @map("is_main")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  business     Business            @relation(fields: [businessId], references: [id])
  stock        BranchStock[]
  sales        Sale[]
  purchases    Purchase[]
  expenses     Expense[]
  shifts       RegisterShift[]
  movements    InventoryMovement[]
  staff        BusinessUser[]
  transfersOut StockTransfer[]     @relation("TransferFrom")
  transfersIn  StockTransfer[]     @relation("TransferTo")

  @@unique([businessId, name])
  @@index([businessId])
  @@map("branches")
}

model BranchStock {
  branchId   BigInt   @map("branch_id")
  productId  BigInt   @map("product_id")
  businessId BigInt   @map("business_id")
  quantity   Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  branch   Branch   @relation(fields: [branchId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@id([branchId, productId])
  @@index([productId])
  @@index([businessId])
  @@map("branch_stock")
}

model StockTransfer {
  id             BigInt   @id @default(autoincrement())
  businessId     BigInt   @map("business_id")
  fromBranchId   BigInt   @map("from_branch_id")
  toBranchId     BigInt   @map("to_branch_id")
  reference      String?  @db.VarChar(100)
  notes          String?
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(100)
  createdBy      BigInt?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business   Business            @relation(fields: [businessId], references: [id])
  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  creator    User?               @relation("TransferCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items      StockTransferItem[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         BigInt  @id @default(autoincrement())
  transferId BigInt  @map("transfer_id")
  productId  BigInt  @map("product_id")
  quantity   Decimal @db.Decimal(12, 3)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@map("stock_transfer_items")
}

model Category {
  id          BigInt   @id @default(autoincrement())
  /// Random identifier shown by the API instead of the sequential `id`.
  publicId    String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  businessId  BigInt   @map("business_id")
  name        String   @db.VarChar(150)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  business Business  @relation(fields: [businessId], references: [id])
  products Product[]

  @@unique([businessId, name])
  @@index([businessId])
  @@map("categories")
}

model Product {
  id             BigInt   @id @default(autoincrement())
  businessId     BigInt   @map("business_id")
  categoryId     BigInt?  @map("category_id")
  name           String   @db.VarChar(255)
  sku            String?  @db.VarChar(100)
  barcode        String?  @db.VarChar(100)
  description    String?
  costPrice      Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
  sellingPrice   Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)
  wholesalePrice Decimal? @map("wholesale_price") @db.Decimal(12, 2)
  unitOfMeasure  String   @default("piece") @map("unit_of_measure") @db.VarChar(50)
  taxClass       String   @default("standard") @map("tax_class") @db.VarChar(20)
  stockQuantity  Decimal  @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  minimumStock   Decimal  @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  business       Business            @relation(fields: [businessId], references: [id])
  category       Category?           @relation(fields: [categoryId], references: [id])
  movements      InventoryMovement[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  quotationItems QuotationItem[]
  invoiceItems   InvoiceItem[]
  branchStock    BranchStock[]
  transferItems  StockTransferItem[]

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId])
  @@index([categoryId])
  @@map("products")
}

model InventoryMovement {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt   @map("business_id")
  branchId   BigInt   @map("branch_id")
  productId  BigInt   @map("product_id")
  type       String   @db.VarChar(50)
  quantity   Decimal  @db.Decimal(12, 3)
  reference  String?  @db.VarChar(100)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([businessId])
  @@index([productId])
  @@index([businessId, productId])
  @@map("inventory_movements")
}

model Customer {
  id          BigInt   @id @default(autoincrement())
  /// Random identifier shown by the API instead of the sequential `id`.
  publicId    String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  businessId  BigInt   @map("business_id")
  name        String   @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  email       String?  @db.VarChar(255)
  address     String?
  taxNumber   String?  @map("tax_number") @db.VarChar(100)
  creditLimit Decimal  @default(0) @map("credit_limit") @db.Decimal(12, 2)
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  business   Business    @relation(fields: [businessId], references: [id])
  sales      Sale[]
  quotations Quotation[]
  invoices   Invoice[]

  @@index([businessId])
  @@index([businessId, phone])
  @@map("customers")
}

model Supplier {
  id         BigInt   @id @default(autoincrement())
  /// Random identifier shown by the API instead of the sequential `id`.
  publicId   String   @unique @default(dbgenerated("gen_random_uuid()")) @map("public_id") @db.Uuid
  businessId BigInt   @map("business_id")
  name       String   @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  email      String?  @db.VarChar(255)
  address    String?
  taxNumber  String?  @map("tax_number") @db.VarChar(100)
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  notes      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  business  Business   @relation(fields: [businessId], references: [id])
  purchases Purchase[]

  @@index([businessId])
  @@index([businessId, phone])
  @@map("suppliers")
}

model Purchase {
  id            BigInt   @id @default(autoincrement())
  businessId    BigInt   @map("business_id")
  branchId      BigInt   @map("branch_id")
  supplierId    BigInt   @map("supplier_id")
  invoiceNumber String?  @map("invoice_number") @db.VarChar(100)
  purchaseDate  DateTime @default(now()) @map("purchase_date") @db.Timestamptz(6)
  subtotal      Decimal  @default(0) @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  tax           Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue    Decimal  @default(0) @map("balance_due") @db.Decimal(12, 2)
  status        String   @default("received") @db.VarChar(50)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  business Business          @relation(fields: [businessId], references: [id])
  branch   Branch            @relation(fields: [branchId], references: [id])
  supplier Supplier          @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]
  payments SupplierPayment[]

  @@index([businessId])
  @@index([supplierId])
  @@index([businessId, purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         BigInt   @id @default(autoincrement())
  purchaseId BigInt   @map("purchase_id")
  productId  BigInt   @map("product_id")
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @map("unit_cost") @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  tax        Decimal  @default(0) @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id               BigInt   @id @default(autoincrement())
  businessId       BigInt   @map("business_id")
  branchId         BigInt   @map("branch_id")
  customerId       BigInt?  @map("customer_id")
  salespersonId    BigInt?  @map("salesperson_id")
  receiptNumber    String   @map("receipt_number") @db.VarChar(100)
  saleDate         DateTime @default(now()) @map("sale_date") @db.Timestamptz(6)
  subtotal         Decimal  @default(0) @db.Decimal(12, 2)
  discount         Decimal  @default(0) @db.Decimal(12, 2)
  tax              Decimal  @default(0) @db.Decimal(12, 2)
  total            Decimal  @default(0) @db.Decimal(12, 2)
  pricesIncludeVat Boolean  @default(false) @map("prices_include_vat")
  amountPaid       Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue       Decimal  @default(0) @map("balance_due") @db.Decimal(12, 2)
  paymentStatus    String   @default("paid") @map("payment_status") @db.VarChar(50)
  status           String   @default("completed") @db.VarChar(50)
  channel          String   @default("walk_in") @db.VarChar(20)
  idempotencyKey   String?  @map("idempotency_key") @db.VarChar(100)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  business    Business   @relation(fields: [businessId], references: [id])
  branch      Branch     @relation(fields: [branchId], references: [id])
  customer    Customer?  @relation(fields: [customerId], references: [id])
  salesperson User?      @relation("SaleSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  payments    Payment[]
  refunds     Refund[]
  invoice     Invoice?
  quotation   Quotation?

  @@unique([businessId, receiptNumber])
  @@unique([businessId, idempotencyKey])
  @@index([businessId])
  @@index([customerId])
  @@index([salespersonId])
  @@index([businessId, saleDate])
  @@map("sales")
}

model SaleItem {
  id        BigInt   @id @default(autoincrement())
  saleId    BigInt   @map("sale_id")
  productId BigInt   @map("product_id")
  quantity  Decimal  @db.Decimal(12, 3)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  costPrice Decimal  @map("cost_price") @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  tax       Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SupplierPayment {
  id          BigInt   @id @default(autoincrement())
  businessId  BigInt   @map("business_id")
  purchaseId  BigInt   @map("purchase_id")
  amount      Decimal  @db.Decimal(12, 2)
  method      String   @db.VarChar(50)
  reference   String?  @db.VarChar(255)
  notes       String?
  createdBy   BigInt?  @map("created_by")
  paymentDate DateTime @default(now()) @map("payment_date") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  purchase Purchase @relation(fields: [purchaseId], references: [id])
  user     User?    @relation(fields: [createdBy], references: [id])

  @@index([businessId])
  @@index([purchaseId])
  @@map("supplier_payments")
}

model Payment {
  id             BigInt   @id @default(autoincrement())
  businessId     BigInt   @map("business_id")
  saleId         BigInt   @map("sale_id")
  amount         Decimal  @db.Decimal(12, 2)
  method         String   @db.VarChar(50)
  reference      String?  @db.VarChar(100)
  paymentDate    DateTime @default(now()) @map("payment_date") @db.Timestamptz(6)
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(100)
  notes          String?
  createdBy      BigInt?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business   Business @relation(fields: [businessId], references: [id])
  sale       Sale     @relation(fields: [saleId], references: [id])
  receivedBy User?    @relation("PaymentReceivedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([businessId, idempotencyKey])
  @@index([createdBy, paymentDate])
  @@index([businessId])
  @@index([saleId])
  @@index([businessId, paymentDate])
  @@map("payments")
}

model Expense {
  id            BigInt   @id @default(autoincrement())
  businessId    BigInt   @map("business_id")
  branchId      BigInt   @map("branch_id")
  category      String   @db.VarChar(100)
  description   String?
  amount        Decimal  @db.Decimal(12, 2)
  expenseDate   DateTime @default(now()) @map("expense_date") @db.Timestamptz(6)
  paymentMethod String?  @map("payment_method") @db.VarChar(50)
  reference     String?  @db.VarChar(100)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@index([businessId])
  @@index([businessId, expenseDate])
  @@index([businessId, category])
  @@map("expenses")
}

model Quotation {
  id               BigInt    @id @default(autoincrement())
  businessId       BigInt    @map("business_id")
  customerId       BigInt?   @map("customer_id")
  quotationNumber  String    @map("quotation_number") @db.VarChar(100)
  quotationDate    DateTime  @default(now()) @map("quotation_date") @db.Timestamptz(6)
  expiryDate       DateTime? @map("expiry_date") @db.Timestamptz(6)
  subtotal         Decimal   @default(0) @db.Decimal(12, 2)
  discount         Decimal   @default(0) @db.Decimal(12, 2)
  tax              Decimal   @default(0) @db.Decimal(12, 2)
  total            Decimal   @default(0) @db.Decimal(12, 2)
  pricesIncludeVat Boolean   @default(false) @map("prices_include_vat")
  status           String    @default("draft") @db.VarChar(50)
  notes            String?
  convertedSaleId  BigInt?   @unique @map("converted_sale_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  business      Business        @relation(fields: [businessId], references: [id])
  customer      Customer?       @relation(fields: [customerId], references: [id])
  convertedSale Sale?           @relation(fields: [convertedSaleId], references: [id])
  items         QuotationItem[]

  @@unique([businessId, quotationNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([businessId, quotationDate])
  @@map("quotations")
}

model QuotationItem {
  id          BigInt   @id @default(autoincrement())
  quotationId BigInt   @map("quotation_id")
  productId   BigInt   @map("product_id")
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  quotation Quotation @relation(fields: [quotationId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

model Invoice {
  id            BigInt    @id @default(autoincrement())
  businessId    BigInt    @map("business_id")
  customerId    BigInt?   @map("customer_id")
  saleId        BigInt    @unique @map("sale_id")
  invoiceNumber String    @map("invoice_number") @db.VarChar(100)
  invoiceDate   DateTime  @default(now()) @map("invoice_date") @db.Timestamptz(6)
  dueDate       DateTime? @map("due_date") @db.Timestamptz(6)
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  discount      Decimal   @default(0) @db.Decimal(12, 2)
  tax           Decimal   @default(0) @db.Decimal(12, 2)
  total         Decimal   @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue    Decimal   @default(0) @map("balance_due") @db.Decimal(12, 2)
  status        String    @default("unpaid") @db.VarChar(50)
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  business Business      @relation(fields: [businessId], references: [id])
  customer Customer?     @relation(fields: [customerId], references: [id])
  sale     Sale          @relation(fields: [saleId], references: [id])
  items    InvoiceItem[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([businessId, invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id        BigInt   @id @default(autoincrement())
  invoiceId BigInt   @map("invoice_id")
  productId BigInt   @map("product_id")
  quantity  Decimal  @db.Decimal(12, 3)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  tax       Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt   @map("business_id")
  userId     BigInt?  @map("user_id")
  action     String   @db.VarChar(50)
  entity     String   @db.VarChar(100)
  entityId   BigInt?  @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([businessId, createdAt])
  @@index([businessId, entity, entityId])
  @@map("audit_logs")
}

model DocumentSequence {
  businessId BigInt @map("business_id")
  kind       String @db.VarChar(50)
  nextValue  BigInt @default(1) @map("next_value")

  business Business @relation(fields: [businessId], references: [id])

  @@id([businessId, kind])
  @@map("document_sequences")
}

model Refund {
  id         BigInt   @id @default(autoincrement())
  businessId BigInt   @map("business_id")
  saleId     BigInt   @map("sale_id")
  amount     Decimal  @db.Decimal(12, 2)
  method     String   @db.VarChar(50)
  reference  String?  @db.VarChar(255)
  reason     String?
  createdBy  BigInt?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business Business @relation(fields: [businessId], references: [id])
  sale     Sale     @relation(fields: [saleId], references: [id])
  user     User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([saleId])
  @@map("refunds")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model RegisterShift {
  id             BigInt    @id @default(autoincrement())
  businessId     BigInt    @map("business_id")
  branchId       BigInt    @map("branch_id")
  openedBy       BigInt    @map("opened_by")
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  openingFloat   Decimal   @map("opening_float") @db.Decimal(12, 2)
  status         String    @default("open") @db.VarChar(10)
  closedBy       BigInt?   @map("closed_by")
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  cashReceived   Decimal?  @map("cash_received") @db.Decimal(12, 2)
  cashRefunded   Decimal?  @map("cash_refunded") @db.Decimal(12, 2)
  cashSupplier   Decimal?  @map("cash_supplier") @db.Decimal(12, 2)
  cashPaidOut    Decimal?  @map("cash_paid_out") @db.Decimal(12, 2)
  expectedCash   Decimal?  @map("expected_cash") @db.Decimal(12, 2)
  countedCash    Decimal?  @map("counted_cash") @db.Decimal(12, 2)
  variance       Decimal?  @db.Decimal(12, 2)
  totalsByMethod Json?     @map("totals_by_method")
  closeNote      String?   @map("close_note")
  managerNote    String?   @map("manager_note")

  business Business @relation(fields: [businessId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  opener   User     @relation("ShiftOpenedBy", fields: [openedBy], references: [id])
  closer   User?    @relation("ShiftClosedBy", fields: [closedBy], references: [id])

  @@map("register_shifts")
}

model PlatformAdmin {
  id                 BigInt    @id @default(autoincrement())
  name               String    @db.VarChar(255)
  email              String    @db.VarChar(255)
  passwordHash       String    @map("password_hash")
  totpSecretEnc      String    @map("totp_secret_enc")
  totpLastStep       BigInt    @default(0) @map("totp_last_step")
  isActive           Boolean   @default(true) @map("is_active")
  sessionsValidAfter DateTime? @map("sessions_valid_after") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  auditLogs PlatformAuditLog[]

  @@map("platform_admins")
}

model PlatformAuditLog {
  id         BigInt   @id @default(autoincrement())
  adminId    BigInt   @map("admin_id")
  action     String   @db.VarChar(100)
  businessId BigInt?  @map("business_id")
  userId     BigInt?  @map("user_id")
  reason     String
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([businessId])
  @@map("platform_audit_logs")
}

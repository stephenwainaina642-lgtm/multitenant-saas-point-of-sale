{
    "compilerOptions":  {
                            "module":  "nodenext",
                            "target":  "esnext",
                            "sourceMap":  true,
                            "noUncheckedIndexedAccess":  true,
                            "exactOptionalPropertyTypes":  true,
                            "strict":  true,
                            "jsx":  "react-jsx",
                            "verbatimModuleSyntax":  true,
                            "isolatedModules":  true,
                            "noUncheckedSideEffectImports":  true,
                            "moduleDetection":  "force",
                            "skipLibCheck":  true,
                            "rootDir":  "./src",
                            "outDir":  "./dist",
                            "types":  [
                                          "node"
                                      ],
                            "declaration":  false,
                            "declarationMap":  false
                        },
    "include":  [
                    "src/**/*.ts"
                ],
    "exclude":  [
                    "node_modules",
                    "dist",
                    "src/generated"
                ]
}
